{
  "name": "ngx-arrow-state",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng s --ssl demo --host 0.0.0.0  --port 4200",
    "build": "ng build ngx-arrow-state && ng build demo && ng build elf-demo && ng build ngrx-signal-store-demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:demo": "ng s demo --ssl  --host 0.0.0.0  --port 4200",
    "serve:elf-demo": "ng s --ssl elf-demo --host 0.0.0.0  --port 4200",
    "serve:ngrx-signal-store-demo": "ng s --ssl ngrx-signal-store-demo --host 0.0.0.0  --port 4200"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-persist-state": "^1.2.1",
    "@ngneat/elf-state-history": "^1.4.0",
    "@ngrx/signals": "^21.0.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^27.1.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
